{
  "name": "inlet",
  "productName": "Inlet",
  "version": "1.9.1",
  "description": "Keeps your Downloads folder clean and finds any file you describe in plain English. Sorts automatically or on demand, remembers where files came from, and everything is undoable.",
  "main": "src/main/main.js",
  "author": "Tech Reign Era Services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tech-Reign-Era-Services/inlet.git"
  },
  "homepage": "https://tech-reign-era-services.github.io/inlet/",
  "bugs": {
    "url": "https://github.com/Tech-Reign-Era-Services/inlet/issues"
  },
  "private": true,
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run icons && electron-builder --mac"
  },
  "build": {
    "appId": "com.techreignera.inlet",
    "productName": "Inlet",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": false,
        "NSDownloadsFolderUsageDescription": "Inlet sorts the files in your Downloads folder into category folders."
      },
      "identity": null
    },
    "files": [
      "src/**/*",
      "build/tray*.png",
      "build/icon.png",
      "package.json"
    ],
    "pkg": {
      "artifactName": "${productName}-${version}.${ext}",
      "welcome": "build/pkg/welcome.html",
      "license": "build/pkg/license.txt",
      "conclusion": "build/pkg/conclusion.html",
      "background": {
        "file": "build/pkg/background.png",
        "alignment": "bottomleft",
        "scaling": "none"
      },
      "scripts": "pkg-scripts",
      "installLocation": "/Applications",
      "isRelocatable": false,
      "isVersionChecked": false,
      "overwriteAction": "upgrade",
      "mustClose": [
        "com.techreignera.inlet"
      ],
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
